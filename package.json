{
  "name": "gold-miner-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build:client && wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:client": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "build": "npm run build:client && npm run build:worker",
    "prepare:deploy": "node scripts/prepare-deploy-config.mjs",
    "deploy": "npm run prepare:deploy && npm run build:client && wrangler d1 migrations apply DB --remote --config .wrangler/deploy.json && wrangler deploy --config .wrangler/deploy.json"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  }
}
